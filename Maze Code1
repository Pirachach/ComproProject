#include <iostream>
#include <windows.h>
#include <conio.h>

using namespace std;

const int width =10;
const int height =20;
int X=0, Y=0;
int maze[height][width] = {0};
char key;
bool start=true;

void DrawMap(){
    system("cls");
    cout << "          ---Build Your MAZE---\n";
    cout << "WASD : Move | SPACE : Wall | Q : Done\n\n" << endl;

    for (int i = 0; i < height; i++) {
    for (int j = 0; j < width; j++) {
            if (i== Y && j == X) cout << "+ "; //Cursor
            
            else if (maze[i][j] == 1) cout << "# "; //Wall
           
            else cout << ". " ; //empty space


        }
        cout << endl;
    }
}

void Input(){
    if (_kbhit()){
  key = _getch();
   if (key == 'q') start = false;
  
   else if (key == 'w' && Y >0) Y--;
   else if(key == 'a' && X >0) X--;
   else if (key == 's' && Y < height-1) Y++;
   else if (key == 'd' && X < width-1) X++;
    }
}

void Logic(){

    if (key == ' ') {
        if(maze[Y][X]==0) maze[Y][X] =1;
        else maze[Y][X]=0;
    }
      key ='\0';
}

int main(){
 
    while(start){
        DrawMap();
        Input();
        Logic();
        Sleep(10);

    }
    system("cls");
   return 0;
}
