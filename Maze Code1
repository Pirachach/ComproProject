#include <iostream>
#include <windows.h>
#include <conio.h>
#include <algorithm>

using namespace std;

const int width =6;
const int height =6;
int X=0, Y=0;
int maze[height][width] = {0};
char key;
bool Running=true;

void gotoxy(int x, int y) {
    COORD c = { (short)x, (short)y };
    SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE), c);
}

void DrawMap(){
    gotoxy(0, 0);
    cout << "          ---Build Your MAZE---\n";
    cout << "WASD : Move | SPACE : Wall | X : Done | Q : START | E : EXIST \n\n" << endl;

    for (int i = 0; i < height; i++) {
    for (int j = 0; j < width; j++) {
            if (i== Y && j == X) cout << "+ "; //Cursor
            else if (maze[i][j] == 0) cout << ". "; //empty
            else if (maze[i][j] == 1) cout << "# "; //Wall
            else if (maze[i][j] == 2) cout << "S "; //Start
            else if (maze[i][j] == 3) cout << "E "; //Exist
            else if (maze[i][j] == 4) cout << "* "; //path
            
        }
        cout <<" "<< endl;
    }
}

void Move(){
    if (_kbhit()){
  key = _getch();
   if (key == 'x' ) Running = false;
   else if (key == 'w' && Y >0) Y--;
   else if (key == 'a' && X >0) X--;
   else if (key == 's' && Y < height-1) Y++;
   else if (key == 'd' && X < width-1) X++;
    }
}

void Walls(){
  // logic for wall
    if (key == ' ') {
        if(maze[Y][X]==0) maze[Y][X] =1;
        else maze[Y][X]=0;
    }
  // logic for Start
    else if (key == 'q'){
     
        for (int i = 0; i < height; i++){
        for (int j = 0; j < width; j++){
       if(maze[i][j]==2) maze[i][j] =0;
      }
    }
    maze[Y][X] =2;
      
    }
  // logic for Exist
    else if (key == 'e'){
     
        for (int i = 0; i < height; i++){
        for (int j = 0; j < width; j++){
       if(maze[i][j]==3) maze[i][j] =0;
      }
    }

    maze[Y][X] =3;
        
    }

      key ='\0';
}

////About AI find an Exist////

// Direction 
string dir ="DLRU";
int dr[4]= {1, 0, 0, -1};
int dc[4]= {0, -1, 1, 0};

//เช็คว่าไปได้ไหม
bool isValid(int r,int c){
    return (r >= 0 && c >= 0 && r < height && c < width && maze[r][c] != 1 && maze[r][c] != 4 );
}



bool findPath(int r, int c){
    if(maze[r][c] == 3) return true; //Found Exist 

    int temp = maze[r][c];
    if (maze[r][c] != 2)maze[r][c] = 4; // ทำเครื่องหมายทางผ่าน (*) ยกเว้นจุดเริ่ม

    // --- ส่วนแสดงผล Real-time ---
    DrawMap();
    Sleep(100); // หน่วงเวลา
    // ---------------------------

    for (int i = 0; i < 4; i++) {
        int nr = r + dr[i];
        int nc = c + dc[i];

        if (isValid(nr, nc)) {
            if (findPath(nr, nc)) return true;
        }
    }
  
    // Backtrack: ถ้าทางนี้ไม่ใช่ ให้คืนค่าเดิม (ยกเว้นจุดเริ่ม)
    if (temp != 2) {
        maze[r][c] = 0; 
        DrawMap();   // วาดใหม่เพื่อให้เห็นตอนมันถอยหลัง
        Sleep(50);
    }
    return false;
}



int main(){
  int startR =-1,startC=-1;
    while(Running){
        DrawMap();
        Move();
        Walls();
        Sleep(100);

    }
     
    cout << "AI IS SOLVING\n";
    
    // ค้นหาจุดเริ่มต้น S 
    for (int i = 0; i < height; i++) {
        for (int j = 0; j < width; j++) {
            if (maze[i][j] == 2) { startR = i; startC = j; break; }
        }
    }

    system("cls");
    if (startR != -1 && findPath(startR, startC)) {
        DrawMap();
        cout << "\nSUCCESS: AI found the way!\n";
    } else {
        DrawMap();
        cout << "\nNo path found! :(\n";
    }

    



    return 0;
}
